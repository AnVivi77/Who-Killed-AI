{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exhibition source asset manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "pathBase", "note", "assets"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "pathBase": {"const": "projectRoot"},
    "note": {"type": "string"},
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "label", "sourcePath", "suggestedPath", "requiredFor"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "kind": {"enum": ["image", "video", "targetImage", "sceneAsset", "database", "audio", "font"]},
          "label": {"type": "string", "minLength": 1},
          "sourcePath": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^SourceAssets/", "minLength": 14}]},
          "suggestedPath": {"type": "string", "pattern": "^SourceAssets/", "minLength": 14},
          "requiredFor": {"enum": ["production", "realScanning", "optional"]}
        }
      }
    }
  }
}
